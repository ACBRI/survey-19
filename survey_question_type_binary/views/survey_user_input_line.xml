<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="survey_user_input_line_view_form_inherit_question_type_binary"
        model="ir.ui.view"
    >
        <field name="name">survey.user_input.line.view.form.inherit</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_text_box']" position="after">
                <field
                    name="answer_binary_ids"
                    mode="kanban"
                    nolabel="1"
                    colspan="2"
                    invisible="answer_type not in ['binary', 'multi_binary']"
                >
                    <kanban>
                        <field name="is_binary_image" />
                        <field name="value_binary_type" />
                        <templates>
                            <t t-name="card" class="flex-row">
                                <aside class="me-2">
                                    <field
                                        t-if="record.is_binary_image.raw_value"
                                        name="value_binary"
                                        widget="image"
                                        options="{'img_class': 'o_image_64_cover'}"
                                        alt="File"
                                    />
                                    <t t-else="">
                                        <t
                                            t-set="file_type"
                                            t-value="record.value_binary_type.raw_value or ''"
                                        />
                                        <i
                                            t-if="file_type == 'application/pdf'"
                                            class="fa fa-file-pdf-o fa-4x"
                                            title="PDF"
                                        />
                                        <i
                                            t-elif="file_type.includes('word')"
                                            class="fa fa-file-word-o fa-4x"
                                            title="Document"
                                        />
                                        <i
                                            t-elif="file_type.includes('excel') or file_type.includes('spreadsheet')"
                                            class="fa fa-file-excel-o fa-4x"
                                            title="Spreadsheet"
                                        />
                                        <i
                                            t-elif="file_type.includes('zip')"
                                            class="fa fa-file-archive-o fa-4x"
                                            title="Archive"
                                        />
                                        <i
                                            t-else=""
                                            class="fa fa-file-o fa-4x"
                                            title="File"
                                        />
                                    </t>
                                </aside>
                                <main class="text-break">
                                    <field name="filename" class="fw-bold" />
                                    <field
                                        name="value_binary_type"
                                        class="text-muted"
                                    />
                                    <field name="value_binary_size_display" />
                                </main>
                            </t>
                        </templates>
                    </kanban>
                </field>
            </xpath>
        </field>
    </record>

    <record id="view_survey_user_input_line_binary_form" model="ir.ui.view">
        <field name="name">survey.user.input.line.binary.form</field>
        <field name="model">survey.user_input.line_binary</field>
        <field name="arch" type="xml">
            <form string="Survey User Input Line Binary">
                <sheet>
                    <group>
                        <field name="filename" invisible="1" />
                        <field name="value_binary" filename="filename" />
                        <field
                            name="value_binary"
                            widget="image"
                            string="Preview"
                            invisible="not is_binary_image"
                        />
                        <field name="value_binary_type" />
                        <field name="value_binary_size_display" />
                        <field name="is_binary_image" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
