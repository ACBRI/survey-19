<odoo>
    <record id="survey_question_form_inherit_question_type_binary" model="ir.ui.view">
        <field name="name">survey.question.view.form.inherit</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_preview_questions')]" position="inside">
                <div invisible="question_type not in ['binary', 'multi_binary']">
                    <p class="mb-0">Send us your files</p>
                    <i
                        class="fa fa-upload fa-4x"
                        role="img"
                        aria-label="Upload"
                        title="Upload"
                    />
                </div>
            </xpath>
            <!-- A file has no correct answer to set -->
            <xpath expr="//page[@name='answers']" position="attributes">
                <attribute
                    name="invisible"
                    add="question_type in ['binary', 'multi_binary']"
                    separator=" or "
                />
            </xpath>
            <xpath expr="//field[@name='validation_required']" position="before">
                <field
                    name="allowed_filemimetypes"
                    invisible="question_type not in ['binary', 'multi_binary']"
                    placeholder="e.g. image/*,application/pdf"
                />
                <field
                    name="max_filesize"
                    invisible="question_type not in ['binary', 'multi_binary']"
                />
            </xpath>
        </field>
    </record>
</odoo>
